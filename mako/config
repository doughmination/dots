# Cyberpunk palette, matches ~/.config/sway/cyberpunk
font=JetBrainsMono Nerd Font 11
background-color=#040A10D9
text-color=#E8FBFD
border-color=#E455AE
progress-color=over #331319
border-size=2
border-radius=14
padding=12
outer-margin=12
width=360
max-visible=5
default-timeout=6000
icons=1
max-icon-size=48
anchor=top-right
layer=overlay
format=<b>%s</b>\n%b

[urgency=low]
border-color=#1AC5B0

[urgency=critical]
border-color=#FB3048
background-color=#710100D9
default-timeout=0

[mode=do-not-disturb]
invisible=1
