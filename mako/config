# Clockwork palette, matches ~/.config/sway/clockwork
font=JetBrainsMono Nerd Font 11
background-color=#050A14D9
text-color=#E9E4DF
border-color=#5FD4F0
progress-color=over #14335A
border-size=2
border-radius=14
padding=12
outer-margin=12
width=360
max-visible=5
default-timeout=6000
icons=1
max-icon-size=48
anchor=top-right
layer=overlay
format=<b>%s</b>\n%b

[urgency=low]
border-color=#4A5A72

[urgency=critical]
border-color=#E0485C
background-color=#5A0F1CD9
default-timeout=0

[mode=do-not-disturb]
invisible=1
