# Clockwork palette, matches ~/.config/sway/clockwork
daemonize
ignore-empty-password
show-failed-attempts
indicator-caps-lock
indicator-idle-visible
hide-keyboard-layout

# lock-screen passes a blurred copy of the wallpaper if imagemagick is installed;
# this is the fallback
image=~/.config/sway/background.png
scaling=fill
color=050A14

font=JetBrainsMono Nerd Font
font-size=22
indicator-radius=110
indicator-thickness=9

# Idle
inside-color=050A14cc
ring-color=5FD4F0ff
line-color=00000000
separator-color=00000000
text-color=E9E4DFff
key-hl-color=D4B072ff
bs-hl-color=E0485Cff

# Checking password
inside-ver-color=050A14cc
ring-ver-color=D4B072ff
line-ver-color=00000000
text-ver-color=D4B072ff

# Wrong password
inside-wrong-color=5A0F1Ccc
ring-wrong-color=E0485Cff
line-wrong-color=00000000
text-wrong-color=E0485Cff

# Cleared input
inside-clear-color=050A14cc
ring-clear-color=4A8FE0ff
line-clear-color=00000000
text-clear-color=4A8FE0ff

# Caps lock on
inside-caps-lock-color=050A14cc
ring-caps-lock-color=E8964Aff
line-caps-lock-color=00000000
text-caps-lock-color=E8964Aff
caps-lock-key-hl-color=D4B072ff
caps-lock-bs-hl-color=E0485Cff
